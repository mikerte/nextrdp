    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <RdpInteropDir>$(MSBuildThisFileDirectory)..\..\artifacts\interop</RdpInteropDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
