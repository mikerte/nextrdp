      "AccessTokenMinutes": 30,
      "RefreshTokenMinutes": 480,
      "DesktopIdleMinutes": 30,
      "DesktopAbsoluteMinutes": 480
    }
  },
  "Authorization": {
    "OpenFga": {
      "BaseAddress": "http://openfga:8080/",
      "StoreId": "",
      "AuthorizationModelId": ""
    },
    "Opa": {
      "BaseAddress": "http://opa:8181/",
      "DecisionPath": "v1/data/nextrdp/phase2/decision"
    }
  },
  "Security": {
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
