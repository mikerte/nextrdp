{
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "NextRdp": ""
  },
  "Authentication": {
    "CorporateOidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-corporate",
      "SignedOutCallbackPath": "/signout-corporate",
      "RequireMfaClaim": true,
      "MfaClaimType": "amr",
      "MfaClaimValues": ["mfa"],
      "GroupRoleMappings": {}
    },
    "DevelopmentIdentity": {
