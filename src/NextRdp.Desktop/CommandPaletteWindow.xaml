<Window x:Class="NextRdp.Desktop.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NextRDP commands" Width="560" Height="430" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" ToolTip="Type to filter commands" AutomationProperties.Name="Filter commands"/>
        <ListBox x:Name="CommandList" Grid.Row="1" Margin="0,10,0,0"
                 Background="{DynamicResource PanelBackground}"
                 Foreground="{DynamicResource PrimaryText}"
                 BorderBrush="{DynamicResource BorderColor}"
                 DisplayMemberPath="Label"
                 MouseDoubleClick="CommandList_MouseDoubleClick"
                 AutomationProperties.Name="Available commands">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonHoverText}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource ItemBackground}"/>
                                        <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource FocusBorder}"/>
                                        <Setter TargetName="ItemChrome" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>
