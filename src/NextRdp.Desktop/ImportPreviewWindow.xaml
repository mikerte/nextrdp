<Window x:Class="NextRdp.Desktop.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import preview" Icon="Assets/nextrdp.ico" Width="900" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Review imported connections" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,14"/>
        <DataGrid x:Name="PreviewGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal" IsReadOnly="False"
                  ScrollViewer.PanningMode="Both" AutomationProperties.Name="Import candidates">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Candidate.Name, StringFormat=Import {0}}"/>
                            <Setter Property="IsEnabled" Value="{Binding CanImport}"/>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Candidate.Name, StringFormat=Import {0}}"/>
                            <Setter Property="IsEnabled" Value="{Binding CanImport}"/>
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Candidate.Name}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Host" Binding="{Binding Target}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal"><Button Content="Select all new" Click="SelectAll_Click" AutomationProperties.Name="Select all new import candidates"/><Button Content="Select none" Click="SelectNone_Click" AutomationProperties.Name="Clear import selection"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="_Cancel" IsCancel="True" MinWidth="90" AutomationProperties.Name="Cancel import"/><Button Content="_Import selected" Click="Import_Click" IsDefault="True" Style="{StaticResource AccentButtonStyle}" MinWidth="130" AutomationProperties.Name="Import selected connections"/></StackPanel>
        </Grid>
    </Grid>
</Window>
